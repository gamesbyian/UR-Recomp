{
  "schema_version": 2,
  "install_root": ".tools",
  "system_packages_ubuntu": [
    "build-essential",
    "cmake",
    "ninja-build",
    "git",
    "python3",
    "python3-venv",
    "pkg-config",
    "libsdl2-dev",
    "ffmpeg",
    "imagemagick",
    "jq",
    "ripgrep",
    "file",
    "cargo",
    "rustc"
  ],
  "tools": [
    {
      "id": "snes9x-libretro",
      "group": "core",
      "url": "https://github.com/snes9xgit/snes9x.git",
      "revision": "1bcc369e89f08243e0a462882fb1f3e42e51de3a",
      "purpose": "Default interpreting reference core for SNESRecomp snesref differential traces.",
      "build": [
        [
          "make",
          "-C",
          "libretro",
          "-j{jobs}"
        ]
      ],
      "artifacts": [
        {
          "path": "libretro/snes9x_libretro.so",
          "kind": "shared-library"
        }
      ],
      "install_mode": "build"
    },
    {
      "id": "superfamiconv",
      "group": "core",
      "url": "https://github.com/Optiroc/SuperFamiconv.git",
      "revision": "566522204e271885fb771b56f1f85d62f3f41430",
      "purpose": "Scriptable SNES palette, tile, map and image conversion/inspection.",
      "build": [
        [
          "cargo",
          "build",
          "--release"
        ]
      ],
      "artifacts": [
        {
          "path": "target/release/superfamiconv",
          "kind": "executable"
        }
      ],
      "install_mode": "build"
    },
    {
      "id": "wla-dx",
      "group": "core",
      "url": "https://github.com/vhelin/wla-dx.git",
      "revision": "91c52b1f4ef3cc8ba3c0638f7536539579af6a9f",
      "purpose": "65816/SPC700 assembler-linker required by snes2asm reconstruction workflows.",
      "build": [
        [
          "cmake",
          "-S",
          ".",
          "-B",
          "build",
          "-DCMAKE_BUILD_TYPE=Release"
        ],
        [
          "cmake",
          "--build",
          "build",
          "-j{jobs}"
        ]
      ],
      "artifacts": [
        {
          "path": "build/binaries/wla-65816",
          "kind": "executable"
        },
        {
          "path": "build/binaries/wlalink",
          "kind": "executable"
        }
      ],
      "install_mode": "build"
    },
    {
      "id": "snes2asm",
      "group": "core",
      "url": "https://github.com/nathancassano/snes2asm.git",
      "revision": "04023b0b589042b212f30c92ec7acf6e6bd010e4",
      "purpose": "SNES disassembler/project generator, installed into an isolated venv and patched narrowly for UR-Recomp: numeric --empty-fill parsing and robust unknown/missing decoder-type validation.",
      "build": [
        [
          "{python}",
          "-m",
          "pip",
          "install",
          "."
        ]
      ],
      "artifacts": [
        {
          "path": "bin/snes2asm",
          "kind": "executable",
          "root": "venv"
        },
        {
          "path": "bin/bmp2chr",
          "kind": "executable",
          "root": "venv"
        },
        {
          "path": "bin/brr",
          "kind": "executable",
          "root": "venv"
        }
      ],
      "install_mode": "build",
      "patches": [
        {
          "path": "tools/patches/snes2asm-ur-recomp.patch",
          "sha256": "360b3b2c01e006a7f2483b56111c60284e3dab303e1a7f0f6070c79b458a6a6e"
        }
      ]
    },
    {
      "id": "cc65",
      "group": "analysis",
      "url": "https://github.com/cc65/cc65.git",
      "revision": "d8a486acdef93ea1ba432a6a35b96cf1b797bda5",
      "purpose": "da65 command-line 65816 disassembler and complementary 65xx analysis utilities.",
      "build": [
        [
          "make",
          "-j{jobs}"
        ]
      ],
      "artifacts": [
        {
          "path": "bin/da65",
          "kind": "executable"
        }
      ],
      "install_mode": "build"
    },
    {
      "id": "ghidra-snes",
      "group": "workbench",
      "url": "https://github.com/joshleaves/ghidra-snes.git",
      "revision": "d33ce5dbfbc3645f00449be1c7ca1c1c65e81756",
      "purpose": "SNES-aware Ghidra loader, 24-bit 65816 language, memory-map helpers and vector/register labels.",
      "requires": [
        "Ghidra 12.0.4",
        "GHIDRA_INSTALL_DIR"
      ],
      "build": [],
      "artifacts": [],
      "install_mode": "manual"
    },
    {
      "id": "bsnes-libretro",
      "group": "oracle-extra",
      "url": "https://github.com/libretro/bsnes-libretro.git",
      "revision": "05439f96121d2b9d7ad7a5fc1f29d7eebdcc8c43",
      "purpose": "Independent high-accuracy libretro oracle for cross-checking emulator-sensitive behavior.",
      "build": [
        [
          "make",
          "-j{jobs}"
        ]
      ],
      "artifacts": [
        {
          "path": "bsnes_libretro.so",
          "kind": "shared-library"
        }
      ],
      "install_mode": "build"
    },
    {
      "id": "beetle-bsnes-libretro",
      "group": "oracle-extra",
      "url": "https://github.com/libretro/beetle-bsnes-libretro.git",
      "revision": "5f05e4c785e936c928ac468e129c55b6f08592cb",
      "purpose": "Independent Mednafen/bsnes-derived SNES libretro oracle that exposes RETRO_MEMORY_SYSTEM_RAM for snesref state/dump workflows. Build disables glibc fortify wrappers to avoid a modern-glibc collision with the bundled historical nall strlcpy/strlcat.",
      "build": [
        [
          "env",
          "CXXFLAGS=-U_FORTIFY_SOURCE -D_FORTIFY_SOURCE=0",
          "CFLAGS=-U_FORTIFY_SOURCE -D_FORTIFY_SOURCE=0",
          "make",
          "-j{jobs}"
        ]
      ],
      "artifacts": [
        {
          "path": "mednafen_snes_libretro.so",
          "kind": "shared-library"
        }
      ],
      "install_mode": "build"
    },
    {
      "id": "flips",
      "group": "patching",
      "url": "https://github.com/bates64/flips.git",
      "revision": "6caac470f7fc096b0c5fdc374b65954f8bac5b16",
      "purpose": "CLI-capable IPS/BPS patch application and creation for preserving/replaying ROM modifications.",
      "build": [
        [
          "make",
          "TARGET=cli",
          "-j{jobs}"
        ]
      ],
      "artifacts": [
        {
          "path": "flips",
          "kind": "executable"
        }
      ],
      "install_mode": "build"
    },
    {
      "id": "ares",
      "group": "workbench",
      "url": "https://github.com/ares-emulator/ares.git",
      "revision": "4cb8d92b441557cb6bcaf133c4cbc7f6819b1122",
      "purpose": "Independent accuracy/preservation-focused emulator for manual behavioral cross-checks.",
      "build": [],
      "artifacts": [],
      "install_mode": "manual"
    },
    {
      "id": "diztinguish",
      "group": "workbench",
      "url": "https://github.com/DizTools/DiztinGUIsh.git",
      "revision": "7484b87c3bd36f4e1a1e9e3c6075dd103855cbfd",
      "purpose": "Trace-assisted collaborative 65816 disassembly; integrates with a patched bsnes+ live trace stream and exports reassemblable source.",
      "build": [],
      "artifacts": [],
      "install_mode": "manual"
    },
    {
      "id": "bsnes-plus",
      "group": "workbench",
      "url": "https://github.com/devinacker/bsnes-plus.git",
      "revision": "a9789fab9a26859153c2963defe186fcaaa80ca2",
      "purpose": "Debugger-oriented bsnes fork with tracing, breakpoints, ROM/RAM views, code/data highlighting, and VRAM/OAM/tilemap inspection.",
      "build": [],
      "artifacts": [],
      "install_mode": "manual"
    },
    {
      "id": "mesen-for-ai",
      "group": "agent-debug",
      "url": "https://github.com/paulomanrique/mesen-for-ai.git",
      "revision": "a4bda6285eadf69c871135637df29e9c9a8f6f7a",
      "purpose": "Headless AI-facing Mesen bridge for frame stepping, memory/register inspection, breakpoints, traces, and SNES code/data logging.",
      "build": [
        [
          "{python}",
          "-m",
          "pip",
          "install",
          "-e",
          "."
        ]
      ],
      "artifacts": [
        {
          "path": "bin/mesen-mcpd",
          "kind": "executable",
          "root": "venv"
        }
      ],
      "install_mode": "build"
    },
    {
      "id": "mesence",
      "group": "agent-debug",
      "url": "https://github.com/nesdev-org/MesenCE.git",
      "revision": "a60e79feb4d6dcced5922d636f9211837d01e381",
      "purpose": "Community-maintained Mesen continuation, pinned to the 2026-09-26 head because post-2.2.1 changes include SNES mid-scanline PPU fixes plus debugger/Lua fixes directly relevant to UR-Recomp validation.",
      "build": [],
      "artifacts": [],
      "install_mode": "manual"
    }
  ]
}
