# PRE_RACE_CARD passive timing reconnaissance.
# One route per process: the native scripted-reset path is known to crash, so
# immediate-confirm and EXIT behavior live in separate fixtures.

until 009F == D7 3600
wait 60
press a 2
until 009F == 3C 1200
wait 60
press a 2
until 009F == 6D 1200
wait 60
press a 2
until 009F == F6 1200
wait 60
press a 2
until 009F == 16 1200
dump ui-pre-race-passive-t000
wait 15
dump ui-pre-race-passive-t015
wait 15
dump ui-pre-race-passive-t030
wait 15
dump ui-pre-race-passive-t045
wait 15
dump ui-pre-race-passive-t060
quit
