# Deterministic native menu route derived from Dessyreqt's 2014 bot.
# Addresses are WRAM offsets (7E:xxxx -> xxxx).
#
# The native harness has established that Uniracers samples a two-frame
# scripted button pulse reliably; the earlier one-frame A pulse was too narrow.

turbo on

# Main menu: Dessyreqt menu.mainMenu = 215 = 0xD7.
until 009F == D7 3600
dump main-menu
press a 2

# One-player rider select: 60 = 0x3C.
until 009F == 3C 1200
dump rider-select
press a 2

# Do not assume the next tours-page label yet. The historical bot knows both
# onePlayerTours1=0x6D and onePlayerTours2=0x10. Prove the rider screen exits,
# then record the actual clean-boot destination.
until 009F != 3C 1200
wait 60
dump after-rider

quit
