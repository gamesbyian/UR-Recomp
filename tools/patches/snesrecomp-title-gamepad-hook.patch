--- a/runner/src/desktop/host_main.c
+++ b/runner/src/desktop/host_main.c
@@ -4607,9 +4607,23 @@
 static void HandleGamepadInput(GamepadInfo *gi, int button, bool pressed) {
+  if (g_game->system_gamepad_button &&
+      g_game->system_gamepad_button(button, pressed))
+    return;
   if (!!(gi->modifiers & (1 << button)) == pressed)
     return;
   gi->modifiers ^= 1 << button;
   if (pressed)
     gi->last_cmd[button] = FindCmdForGamepadButton(button + gi->index * kGamepadBtn_Count, gi->modifiers);
+  /* Some title-owned product gestures need the player's semantic SNES
+   * controls, not the physical SDL button. Keep the older raw-button seam
+   * above for host shortcuts, then expose only mapped P1 controller commands
+   * here. Press and release use the same remembered command so a title that
+   * consumes a press can consume its matching release as well. */
+  if (g_game->system_gamepad_control &&
+      gi->last_cmd[button] >= kKeys_Controls &&
+      gi->last_cmd[button] <= kKeys_Controls_Last &&
+      g_game->system_gamepad_control(
+          (int)(gi->last_cmd[button] - kKeys_Controls), pressed))
+    return;
   if (gi->last_cmd[button] != 0)
     SetPadButtonOrFallthrough(gi->last_cmd[button], pressed);
 }
