# Native Quick Practice routing-cancel acceptance.
# The workflow uses the existing acceptance-only auto-start hook at settled
# Modern main, freezes the process after stock rider select is captured, queues
# Escape, then resumes. The host must restore the Practice snapshot/root and
# settle back at Modern main without entering a Practice race.

until 009F == D7 3600
dump practice-cancel-main
until 009F == 3C 1800
dump practice-cancel-routing
until 009F == D7 1800
wait 60
dump practice-cancel-returned-main
quit
