# One-frame race-entry scheduler-origin probe.
# Localizes the first native/Snes9x divergence in $0300/$0302/$0304 around inRace transition.
wait 1128
dump phase-origin-1128
wait 1
dump phase-origin-1129
wait 1
dump phase-origin-1130
wait 1
dump phase-origin-1131
wait 1
dump phase-origin-1132
wait 1
dump phase-origin-1133
wait 1
dump phase-origin-1134
wait 1
dump phase-origin-1135
wait 1
dump phase-origin-1136
wait 1
dump phase-origin-1137
wait 1
dump phase-origin-1138
wait 1
dump phase-origin-1139
wait 1
dump phase-origin-1140
quit
