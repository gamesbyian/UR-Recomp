diff --git a/bsnes/target-libretro/libretro.cpp b/bsnes/target-libretro/libretro.cpp
index 66ba7ce..bdb2174 100644
--- a/bsnes/target-libretro/libretro.cpp
+++ b/bsnes/target-libretro/libretro.cpp
@@ -1036,12 +1036,19 @@ unsigned retro_get_region()
 
 // Currently, there is no safe/sensible way to use the memory interface without severe hackery.
 // Rely on higan to load and save SRAM until there is really compelling reason not to.
+// UR-Recomp research patch: expose the CPU's 128 KiB work RAM so headless
+// harnesses can read guest state from the high-accuracy core (and apply an
+// optional zero fill before boot). No timing or emulation change.
+namespace SuperFamicom { uint8_t* urResearchWorkRam(); }
+
 void *retro_get_memory_data(unsigned id)
 {
+	if (id == RETRO_MEMORY_SYSTEM_RAM) return SuperFamicom::urResearchWorkRam();
 	return nullptr;
 }
 
 size_t retro_get_memory_size(unsigned id)
 {
+	if (id == RETRO_MEMORY_SYSTEM_RAM) return 128 * 1024;
 	return 0;
 }
