@@ -226,5 +226,22 @@ int snesrecomp_desktop_set_display_mode(int mode);
 int snesrecomp_desktop_get_display_mode(void);
 
+/* Active-monitor fullscreen capability. The host normalizes SDL2/SDL3 mode
+ * enumeration so title/product code never depends on SDL's version-specific
+ * display identifiers or mode ownership rules. refresh_millihz is zero when
+ * the platform does not report a refresh rate. The setter accepts only an
+ * exact mode returned by this API; it configures the mode used by exclusive
+ * fullscreen and does not itself change the window's fullscreen state. */
+typedef struct SnesDesktopOutputMode {
+  int width;
+  int height;
+  int refresh_millihz;
+} SnesDesktopOutputMode;
+int snesrecomp_desktop_output_mode_count(void);
+int snesrecomp_desktop_get_output_mode(
+    int index,
+    SnesDesktopOutputMode *out);
+int snesrecomp_desktop_get_native_output_mode(
+    SnesDesktopOutputMode *out);
+int snesrecomp_desktop_set_output_mode(
+    const SnesDesktopOutputMode *mode);
+
 /* Ask the host to reset its pacing clock at the next opportunity (a title
  * that just changed its presentation settings). */
 void snesrecomp_desktop_request_clock_reset(void);
