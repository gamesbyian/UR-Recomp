# Fresh-process Modern Continue Tour acceptance.
# The host must route the authoritative stock frontend from main menu to the
# persisted tour's TRACK_SELECT surface, then relinquish control without
# auto-selecting an event.

until 009F == D7 3600
wait 60
dump tour-continue-main-ready

until 009F == F6 2400
wait 60
dump tour-continue-track-ready

quit
