# Historical 2014 bot medal-progression acceptance.
# Controller input comes from SNESREF_INPUT_FILE.
# Baseline is after SRAM/frontend initialization but before first race entry (frame 794).
# Later dumps form a bounded scan; workflow selects the first snapshot with a medal-matrix mutation.
wait 750
dump progression-before
wait 2250
dump progression-scan-03000
wait 3000
dump progression-scan-06000
wait 3000
dump progression-scan-09000
wait 3000
dump progression-scan-12000
wait 3000
dump progression-scan-15000
wait 3000
dump progression-scan-18000
quit
