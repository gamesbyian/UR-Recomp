+static void StartupLogFailure(const char *code, const char *subsystem,
+                              const char *path, const char *result) {
+  const char *log_path = HostGetenv("STARTUP_LOG");
+  if (!log_path || !log_path[0]) return;
+  FILE *f = fopen(log_path, "ab");
+  if (!f) return;
+  fprintf(f, "code=%s\n", code ? code : "UR-STARTUP-UNKNOWN");
+  fprintf(f, "subsystem=%s\n", subsystem ? subsystem : "unknown");
+  if (path && path[0]) fprintf(f, "path=%s\n", path);
+  fprintf(f, "result=%s\n", result ? result : "fatal");
+  fclose(f);
+}
+
+static int StartupFail(const char *code, const char *subsystem,
+                       const char *path, const char *explanation,
+                       const char *action) {
+  StartupLogFailure(code, subsystem, path, "fatal");
+  fprintf(stderr, "%s: %s", code, explanation);
+  if (path && path[0]) fprintf(stderr, " Path: %s.", path);
+  if (action && action[0]) fprintf(stderr, " %s", action);
+  fputc('\n', stderr);
+  return 1;
+}
