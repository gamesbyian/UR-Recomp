+#if defined(_WIN32)
+#include <direct.h>
+#include <wchar.h>
+#endif
+
+static int dir_is_writable(const char *dir) {
+    char probe[1024];
+    size_t len = dir ? strlen(dir) : 0;
+    const char *sep =
+        (len > 0 && dir[len - 1] != '/' && dir[len - 1] != '\\') ? "/" : "";
+    if (!dir || !dir[0] ||
+        snprintf(probe, sizeof(probe), "%s%s.snesrecomp_write_probe",
+                 dir, sep) >= (int)sizeof(probe))
+        return 0;
+    FILE *f = fopen(probe, "wb");
+    if (!f) return 0;
+    fclose(f);
+    remove(probe);
+    return 1;
+}
+
+int snesrecomp_anchor_to_exe_dir(void) {
+#if defined(_WIN32)
+    /* The CRT narrow environment and filesystem calls use the active ANSI
+     * code page. They cannot represent a Windows account/root containing
+     * characters outside that page. The launcher supplies a native UTF-16
+     * environment value, so keep it wide through the probe and chdir. */
+    const wchar_t *wide_root = _wgetenv(L"SNESRECOMP_USER_DATA_DIR");
+    if (wide_root && *wide_root) {
+        wchar_t probe[1024];
+        size_t len = wcslen(wide_root);
+        const wchar_t *sep =
+            (len && wide_root[len - 1] != L'/' && wide_root[len - 1] != L'\\')
+                ? L"\\" : L"";
+        int count = swprintf(probe, sizeof(probe) / sizeof(probe[0]),
+                             L"%ls%ls.snesrecomp_write_probe", wide_root, sep);
+        if (count < 0 || (size_t)count >= sizeof(probe) / sizeof(probe[0]))
+            return 0;
+        FILE *f = _wfopen(probe, L"wb");
+        if (!f) return 0;
+        fclose(f);
+        if (_wremove(probe) != 0 || _wchdir(wide_root) != 0) return 0;
+        const char *display_root = getenv("SNESRECOMP_USER_DATA_DIR");
+        fprintf(stderr, "[Launcher] Config/saves anchored to user data '%s'.\n",
+                display_root ? display_root : "(native Windows path)");
+        return 1;
+    }
+#endif
+    char dir[1024];
+    const char *user_data = getenv("SNESRECOMP_USER_DATA_DIR");
+    if (user_data && user_data[0]) {
+        if (snprintf(dir, sizeof(dir), "%s", user_data) >= (int)sizeof(dir)) {
+            fprintf(stderr,
+                    "[Launcher] Config/save root is too long: '%s'.\n",
+                    user_data);
+            return 0;
+        }
+    } else {
+        get_exe_dir(dir, sizeof(dir));
+    }
+    if ((!user_data || !user_data[0]) &&
+        dir[0] == '.' &&
+        (dir[1] == '/' || dir[1] == '\\' || dir[1] == '\0'))
+        return 0;
+    if (!dir_is_writable(dir)) {
+        fprintf(stderr,
+                "[Launcher] Executable directory '%s' is not writable; "
+                "config and saves stay in the current directory.\n", dir);
+        return 0;
+    }
+    if (snesrecomp_chdir(dir) != 0) {
+        fprintf(stderr, "[Launcher] Could not change directory to '%s'.\n", dir);
+        return 0;
+    }
+    if (user_data && user_data[0])
+        fprintf(stderr,
+                "[Launcher] Config/saves anchored to user data '%s'.\n", dir);
+    else
+        fprintf(stderr, "[Launcher] Config/saves anchored to '%s'.\n", dir);
+    return 1;
+}
