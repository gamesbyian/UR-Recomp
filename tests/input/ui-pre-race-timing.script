# PRE_RACE_CARD timing and skip reconnaissance.
# Branch 1 samples the card without input.
# Branch 2 reaches the card from reset and immediately presses A.

# Passive timing branch.
until 009F == D7 3600
wait 60
press a 2
until 009F == 3C 1200
wait 60
press a 2
until 009F == 6D 1200
wait 60
press a 2
until 009F == F6 1200
wait 60
press a 2
until 009F == 16 1200
dump ui-pre-race-passive-t000
wait 15
dump ui-pre-race-passive-t015
wait 15
dump ui-pre-race-passive-t030
wait 15
dump ui-pre-race-passive-t045
wait 15
dump ui-pre-race-passive-t060

# Immediate-A branch.
reset
until 009F == D7 3600
wait 60
press a 2
until 009F == 3C 1200
wait 60
press a 2
until 009F == 6D 1200
wait 60
press a 2
until 009F == F6 1200
wait 60
press a 2
until 009F == 16 1200
dump ui-pre-race-skip-before
press a 2
wait 15
dump ui-pre-race-skip-after-015
wait 45
dump ui-pre-race-skip-after-060

quit
