   int (*system_key_down)(int key, int mod, int repeat);
 
+  /* Optional title-owned normalized physical gamepad-button seam. Called
+   * before the configured GamepadMap/guest mapping. Return nonzero to
+   * consume. Existing title shortcuts may intentionally use this surface. */
+  int (*system_gamepad_button)(int button, int pressed);
