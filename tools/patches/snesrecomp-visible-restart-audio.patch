+/* A player-requested Restart is a *visible* timeline jump. Keep the regular
+ * rollback loader unchanged for invisible runahead/netplay: those callers
+ * must retain their current output ring and host generation. Modern Restart
+ * instead discards samples generated on the abandoned attempt, re-primes the
+ * delivery resampler, and tells the desktop host to clear its SDL stream on
+ * the next event-loop iteration. Do not touch synthesizer state or SPC time. */
+void RtlAudioInvalidateVisibleTimeline(void) {
+  if (!g_snes || !g_snes->apu || !g_snes->apu->dsp)
+    return;
+  RtlApuLock();
+  (void)dsp_trimSamples(g_snes->apu->dsp, 0u);
+  rtl_reset_audio_delivery();
+  g_audio_fast_forward = false;
+  g_audio_recovery_frames = 0;
+  g_audio_recovery_remaining = 0;
+  g_audio_recovery_anchor_l = 0;
+  g_audio_recovery_anchor_r = 0;
+  g_audio_last_output_l = 0;
+  g_audio_last_output_r = 0;
+  RtlApuUnlock();
+  ++s_state_generation;
+}
