# Safe UI reconnaissance: Options -> Define League -> League naming screen.
# No membership edits and no name confirmation are performed.

until 009F == D7 3600
wait 60

# Main Menu -> OPTIONS (fifth item)
press down 1
press down 1
press down 1
press down 1
wait 30
press a 2
wait 60

# Options -> DEFINE LEAGUE (fourth item)
press down 1
press down 1
press down 1
wait 30
dump ui-define-league-selected
press a 2
wait 60
dump ui-define-league-entry

# Manual: Start confirms the selected League membership and opens naming.
# With no membership edits, this is observation-only for the frontend.
press start 2
wait 60
dump ui-name-league-entry

quit
