wait 5
dump phase-entry-1140
wait 5
dump phase-entry-1145
wait 5
dump phase-entry-1150
wait 5
dump phase-entry-1155
wait 5
dump phase-entry-1160
wait 5
dump phase-entry-1165
wait 5
dump phase-entry-1170
wait 5
dump phase-entry-1175
wait 5
dump phase-entry-1180
wait 5
dump phase-entry-1185
wait 5
dump phase-entry-1190
wait 5
dump phase-entry-1195
wait 5
dump phase-entry-1200
wait 5
dump phase-entry-1205
wait 5
dump phase-entry-1210
wait 5
dump phase-entry-1215
wait 5
dump phase-entry-1220
