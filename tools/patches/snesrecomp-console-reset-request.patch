+static uint32_t g_session_reboot_sram_digest;
+
+static uint32_t session_reboot_sram_digest(void) {
+  uint32_t hash = 2166136261u;
+  for (int i = 0; i < g_sram_size; ++i) {
+    hash ^= g_sram[i];
+    hash *= 16777619u;
+  }
+  return hash;
+}
+
+int snesrecomp_desktop_request_session_reboot(void) {
+#if defined(SNES_HAS_LOBBY_CLIENT)
+  if (snes_netplay_active())
+    return 0;
+#endif
+  if (!g_snes || !g_sram || g_sram_size <= 0)
+    return 0;
+  if (!RtlTryWriteSram())
+    return 0;
+  g_session_reboot_sram_digest = session_reboot_sram_digest();
+  g_session_reboot_requested = 1;
+  return 1;
+}
 
