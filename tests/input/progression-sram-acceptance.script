wait 4000
dump progression-scan-12000
wait 4000
dump progression-scan-16000
wait 4000
dump progression-scan-20000
wait 4000
dump progression-scan-24000
wait 4000
dump progression-scan-28000
wait 4000
dump progression-scan-32000
wait 4000
dump progression-scan-36000
wait 4000
dump progression-scan-40000
quit
