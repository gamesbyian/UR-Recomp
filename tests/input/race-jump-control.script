# Deterministic first-race route derived from Dessyreqt's 2014 state-driven bot.
# Addresses are WRAM offsets (7E:xxxx -> xxxx).
#
# Native observation: a menu-state byte can become visible before that menu
# accepts a confirm edge. Give each newly reached menu 60 guest frames to settle
# before its first A pulse. Do not poke guest state.

# Main menu: Dessyreqt menu.mainMenu = 215 = 0xD7.
until 009F == D7 3600
wait 60
dump main-menu-ready
press a 2

# One-player rider select: 60 = 0x3C.
until 009F == 3C 1200
wait 60
dump rider-select-ready
press a 2

# Clean native route enters onePlayerTours1 = 0x6D.
until 009F == 6D 1200
wait 60
dump tours-ready
press a 2

# Verified one-player track select: 0xF6.
until 009F == F6 1200
wait 60
dump tracks-ready
press a 2

# Prospectively test the recovered bot's onePlayerNowPlaying = 0x16 label.
# Preserve the first settled post-track state before requiring the prediction.
until 009F != F6 1200
wait 60
dump after-track-confirm
until 009F == 16 1200
wait 60
dump now-playing-ready
press a 2

# Recovered bot labels 7E:0313 as inRace, with 1 meaning active race.
until 0313 == 01 1800
wait 60
dump race-entered


# Race-behavior probe 1: straight-line acceleration.
# Each press command includes one trailing idle frame in the shared grammar.
# Checkpoints are therefore event-relative and identical across native/snesref.

press right 30
dump accel-030

press right 30
dump accel-060

press right 30
dump accel-090

press right 30
dump accel-120

press right 60
dump accel-180


# Matched control for the moving jump probe.
# Identical timing and Right input, but omit B so jump-vs-control differences
# can be attributed causally to the jump button rather than track progression.

press right 2
dump jump-trigger

press right 4
dump jump-early

press right 6
dump jump-rise

press right 12
dump jump-mid

press right 24
dump jump-late

press right 36
dump jump-settle

quit
