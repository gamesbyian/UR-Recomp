# Deterministic second-tour first-race route derived from Dessyreqt's 2014 state-driven bot.
# Addresses are WRAM offsets (7E:xxxx -> xxxx).
#
# Native observation: a menu-state byte can become visible before that menu
# accepts a confirm edge. Give each newly reached menu 60 guest frames to settle
# before its first A pulse. Do not poke guest state.

# Main menu: Dessyreqt menu.mainMenu = 215 = 0xD7.
until 009F == D7 3600
wait 60
dump main-menu-ready
press a 2

# One-player rider select: 60 = 0x3C.
until 009F == 3C 1200
wait 60
dump rider-select-ready
press a 2

# Clean native route enters onePlayerTours1 = 0x6D.
until 009F == 6D 1200
wait 60
dump tours-ready

# Select tour index 2 (third tour) using Dessyreqt's recovered menu model.
# targetTour=2 => targetRow=2, targetCol=0; the initial clean selection is
# selectedOption=0, so one Down edge should move to selectedOption=2.
press down 2
until 009B == 02 600
wait 30
dump tour2-selected
press a 2

# Verified one-player track select: 0xF6.
until 009F == F6 1200
wait 60
dump tracks-ready
press a 2

# Prospectively test the recovered bot's onePlayerNowPlaying = 0x16 label.
# Preserve the first settled post-track state before requiring the prediction.
until 009F != F6 1200
wait 60
dump after-track-confirm
until 009F == 16 1200
wait 60
dump now-playing-ready
press a 2

# Fine-grained course-load timeline after the final Now Playing confirm.
# The press command itself includes its trailing idle frame; post-confirm-000 is
# therefore the first checkpoint after the scripted confirm completes.
press a 2
dump post-confirm-000

wait 1
dump post-confirm-001

wait 1
dump post-confirm-002

wait 2
dump post-confirm-004

wait 4
dump post-confirm-008

wait 8
dump post-confirm-016

wait 16
dump post-confirm-032

wait 4
dump post-confirm-036

wait 4
dump post-confirm-040

wait 1
dump post-confirm-041

wait 1
dump post-confirm-042

wait 1
dump post-confirm-043

wait 1
dump post-confirm-044

wait 1
dump post-confirm-045

wait 1
dump post-confirm-046

wait 1
dump post-confirm-047

wait 1
dump post-confirm-048

wait 4
dump post-confirm-052

wait 4
dump post-confirm-056

wait 4
dump post-confirm-060

wait 4
dump post-confirm-064

wait 32
dump post-confirm-096

wait 32
dump post-confirm-128

wait 16
dump post-confirm-144

until 0313 == 01 600
dump race-active

quit
