# QA-01 external-route candidate, not a release-gating fixture.
# Source of driving rhythm: baldosa/uniracers-recomp tests/routes/zoomzoo_1p.txt
# commit 10b864b9d14a7b7416dd909eb7b054c88faef101.
# Entry sequence uses our established ui-circuit-result-route.script grammar.
# No complete native/reference result is claimed by adding this file.
# Follow upstream Mike / Crawler Tour / Zoom Zoo menu input order.
# Upstream 16-bit state 0053 == F60C (little-endian bytes 0C F6).
until 0053 == 0C 3600
until 0054 == F6 3600
wait 300
press start 2
wait 200
press start 2
wait 200
press start 2
wait 200
press down 2
wait 30
press start 2
wait 200
press start 2
# Upstream GO precondition: 0053 == 8610 (bytes 10 86).
until 0053 == 10 18000
until 0054 == 86 18000
dump baldosa-zoo-before-go
until 0E1F != 00 18000
dump baldosa-zoo-go-phase
press left 300
press left+up 20
press left 200
press left+down 20
press left 200
press left+l 40
press left 200
press left+r 40
press left+y 20
press left 900
press left+x 20
press left 6000
dump baldosa-zoo-after-drive
# The upstream script waits for the menu NMI handler; our stronger
# candidate checks the original circuit result screen, 009F == BC.
until 009F == BC 12000
wait 60
dump baldosa-zoo-result-candidate
quit
