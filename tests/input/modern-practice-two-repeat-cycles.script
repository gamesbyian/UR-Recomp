# Two consecutive completed Quick Practice repeat cycles through the real host.
# First repeat uses the existing acceptance hook; second uses an actual SDL
# keyboard R sent by run_practice_repeat_two_cycles_acceptance.sh.
# No guest-state writes or synthetic completion.
until 009F == D7 3600
dump practice-repeat-main
until 0313 == 01 3600
wait 60
dump practice-repeat-first-race

