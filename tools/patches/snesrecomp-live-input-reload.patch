+static void ResetInputFilePlayback(void) {
+  g_input_event_count = 0;
+  g_input_event_cursor = 0;
+  g_input_p1_mask = 0;
+  g_input_p2_mask = 0;
+  g_input_p1_end = 0;
+  g_input_p2_end = 0;
+  g_input_relative_enabled = 0;
+  g_input_relative_armed = 0;
+  g_input_relative_origin = 0;
+}
+
+int snesrecomp_desktop_load_relative_input_file(const char *path) {
+  ResetInputFilePlayback();
+  if (!path || !*path)
+    return 0;
+  if (!LoadInputFile(path)) {
+    ResetInputFilePlayback();
+    return 0;
+  }
+  g_input_relative_enabled = 1;
+  return 1;
+}
