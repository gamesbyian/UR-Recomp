+/* Re-present the frozen field with the title's CURRENT system overlay while
+ * the host is paused. No guest code runs: the backdrop is the copy taken
+ * before the overlay on the last real present, scaled (nearest) to the
+ * current presentation density so a density change made from a paused
+ * Options menu is reflected immediately. */
+static void PresentPausedSystemOverlay(void) {
+  if (!g_paused_overlay_present || !g_game->system_overlay ||
+      g_paused_backdrop_w <= 0 || g_paused_backdrop_h <= 0)
+    return;
+  int render_scale = g_game->presentation_scale
+      ? g_game->presentation_scale()
+      : 1;
+  if (render_scale < 1 || render_scale > 4)
+    render_scale = 1;
+  const int w = g_snes_width * render_scale;
+  const int h = g_snes_height * render_scale;
+  uint8 *pixel_buffer = 0;
+  int pitch = 0;
+  g_renderer_funcs.BeginDraw(w, h, &pixel_buffer, &pitch);
+  if (!pixel_buffer) {
+    g_renderer_funcs.EndDraw();
+    return;
+  }
+  snes_ovl_upscale_frame(pixel_buffer, pitch, w, h,
+                         (const uint32_t *)g_paused_backdrop,
+                         g_paused_backdrop_w * 4,
+                         g_paused_backdrop_w, g_paused_backdrop_h);
+  g_game->system_overlay(pixel_buffer, (size_t)pitch, w, h);
+  ComposeOsd(pixel_buffer, pitch, w, h, 2);
+  {
+    /* SNESRECOMP_PAUSED_OVERLAY_DUMP=<path.ppm>: the paused UI can only be
+     * checked by what reaches the screen; rewrite the latest paused present. */
+    const char *dump = HostGetenv("PAUSED_OVERLAY_DUMP");
+    if (dump && dump[0])
+      WritePpm(dump, pixel_buffer, pitch, w, h, g_present_frame, false);
+  }
+  g_renderer_funcs.EndDraw();
+}
