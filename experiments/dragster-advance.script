# Deterministic first-race route derived from Dessyreqt's 2014 state-driven bot.
# Addresses are WRAM offsets (7E:xxxx -> xxxx).
#
# This first whole-race probe intentionally stays simple. It reuses the verified
# clean frontend and acceleration path, then repeats the already-validated
# 24-frame sustained-B / 24-frame release jump rhythm while holding Right.
# If this does not finish Dragster, the terminal/progress dumps make the missing
# steering/rotation/timing requirement measurable rather than speculative.

until 009F == D7 3600
wait 60
dump main-menu-ready
press a 2

until 009F == 3C 1200
wait 60
dump rider-select-ready
press a 2

until 009F == 6D 1200
wait 60
dump tours-ready
press a 2

until 009F == F6 1200
wait 60
dump tracks-ready
press a 2

until 009F != F6 1200
wait 60
dump after-track-confirm
until 009F == 16 1200
wait 60
dump now-playing-ready
press a 2

until 0313 == 01 1800
wait 60
dump race-entered

press right 30
press right 30
press right 30
press right 30
press right 60
dump finish-probe-start

press right+b 24
press right 24
press right+b 24
press right 24
press right+b 24
press right 24
press right+b 24
press right 24
press right+b 24
press right 24
dump finish-probe-05
press right+b 24
press right 24
press right+b 24
press right 24
press right+b 24
press right 24
press right+b 24
press right 24
press right+b 24
press right 24
dump finish-probe-10
press right+b 24
press right 24
press right+b 24
press right 24
press right+b 24
press right 24
press right+b 24
press right 24
press right+b 24
press right 24
dump finish-probe-15
press right+b 24
press right 24
press right+b 24
press right 24
press right+b 24
press right 24
press right+b 24
press right 24
press right+b 24
press right 24
dump finish-probe-20
press right+b 24
press right 24
press right+b 24
press right 24
press right+b 24
press right 24
press right+b 24
press right 24
press right+b 24
press right 24
dump finish-probe-25
press right+b 24
press right 24
press right+b 24
press right 24
press right+b 24
press right 24
press right+b 24
press right 24
press right+b 24
press right 24
dump finish-probe-30

dump finish-probe-terminal
# Dessyreqt labels raceResults = 153 decimal = 0x99.
# Stop only on an observed stock results screen; do not poke guest state.
until 009F == 99 600
wait 30
dump race-results
# Advance through real results with a controller input; retain both sides.
press a 2
wait 180
dump after-results-ack
# Attempt the next actual event from the observed F6 track menu, without guest-state injection.
press down 2
wait 60
dump next-track-highlight
press a 2
until 009F == 16 1200
wait 60
dump next-now-playing
press a 2
until 0313 == 01 1800
wait 60
dump next-race-entered
# Continue the second genuine course with the same previously successful player input rhythm.
# A new result is required; entering the next race alone does not qualify progression.
press right 30
press right 30
press right 30
press right 30
press right 60
press right+b 24
press right 24
press right+b 24
press right 24
press right+b 24
press right 24
press right+b 24
press right 24
press right+b 24
press right 24
dump second-finish-probe-05
press right+b 24
press right 24
press right+b 24
press right 24
press right+b 24
press right 24
press right+b 24
press right 24
press right+b 24
press right 24
dump second-finish-probe-10
press right+b 24
press right 24
press right+b 24
press right 24
press right+b 24
press right 24
press right+b 24
press right 24
press right+b 24
press right 24
dump second-finish-probe-15
press right+b 24
press right 24
press right+b 24
