# QA-01 source-menu discriminator, NOT a course acceptance or gameplay fix.
# Faithful selection to gamesbyian/uniracers-recomp
# tests/routes/zoomzoo_1p.txt @ 10b864b9d14a7b7416dd909eb7b054c88faef101.
# Upstream uses until16 0053 == F60C / 8610. Two little-endian
# byte predicates here retain the existing native script's until syntax.
# Do not substitute A-button menu navigation for upstream Start semantics.
until 0053 == 0C 3600
until 0054 == F6 1200
dump baldosa-zoo-upstream-menu-ready
wait 300
press start 2
wait 200
dump baldosa-zoo-upstream-first-start
press start 2
wait 200
press start 2
wait 200
press down 2
wait 30
press start 2
wait 200
press start 2
until 0053 == 10 1800
until 0054 == 86 1800
until 0E1F != 00 1800
dump baldosa-zoo-go-phase
press left 300
press left+up 20
press left 200
press left+down 20
press left 200
press left+l 40
press left 200
press left+r 40
press left+y 20
press left 900
press left+x 20
press left 6000
dump baldosa-zoo-after-drive
# Upstream ends at the 16-bit post-result F60C menu state.
# Reconstruct the independent source condition; this checkpoint alone
# does not establish a scored result, progression, or a cold-save witness.
until 0053 == 0C 12000
until 0054 == F6 1200
wait 60
dump baldosa-zoo-result-candidate
quit
