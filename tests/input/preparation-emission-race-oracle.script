# Extended stock-only source run for the +16 presentation-capacity oracle.
# It shares the exact deterministic route with preparation-emission-race.script
# and continues the final rightward hold beyond the bounded widened fixture.
until 009F == D7 3600
wait 60
press a 2
until 009F == 3C 1200
wait 60
press a 2
until 009F == 6D 1200
wait 60
press a 2
until 009F == F6 1200
wait 60
press a 2
until 009F != F6 1200
wait 60
until 009F == 16 1200
wait 60
press a 2
until 0313 == 01 1200
wait 30
dump prep-emission-before-scroll
press right 980
dump prep-emission-after-scroll
quit
