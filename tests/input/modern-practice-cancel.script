# Native Quick Practice routing-cancel acceptance.
# The workflow uses acceptance-only host hooks at settled Modern main and at
# stock rider select. Cancellation is issued on an emulated-frame boundary
# after the rider-select checkpoint is observable, then the ordinary abort path
# must restore the Practice snapshot/root and settle back at Modern main.

until 009F == D7 3600
dump practice-cancel-main
until 009F == 3C 1800
dump practice-cancel-routing
until 009F == D7 1800
wait 60
dump practice-cancel-returned-main
quit
