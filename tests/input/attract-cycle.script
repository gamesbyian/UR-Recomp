# Attract-cycle probe: clean boot to MAIN_MENU, then no input for four demo cycles.
# Consumed by tools/probe_attract_cycle.py (per-frame low-WRAM trace).
until 009F == D7 3600
# Mid first demo race (race runs ~frames 1090-3280 after MAIN_MENU): $9F 0x00, in-race 1.
wait 1500
dump attract-demo-race
wait 12100
quit
