# Deterministic stock first-race route followed by one uninterrupted camera-moving run.
# The long hold is deliberate: script "press" commands insert a release frame after
# each command, so repeated one-frame presses cannot provide contiguous movement.
until 009F == D7 3600
wait 60
press a 2
until 009F == 3C 1200
wait 60
press a 2
until 009F == 6D 1200
wait 60
press a 2
until 009F == F6 1200
wait 60
press a 2
until 009F != F6 1200
wait 60
until 009F == 16 1200
wait 60
press a 2
until 0313 == 01 1200
wait 30
dump prep-emission-before-scroll
press right 900
dump prep-emission-after-scroll
quit
