# Deterministic first-race route derived from Dessyreqt's 2014 state-driven bot.
# Addresses are WRAM offsets (7E:xxxx -> xxxx).
#
# This first whole-race probe intentionally stays simple. It reuses the verified
# clean frontend and acceleration path, then repeats the already-validated
# 24-frame sustained-B / 24-frame release jump rhythm while holding Right.
# If this does not finish Dragster, the terminal/progress dumps make the missing
# steering/rotation/timing requirement measurable rather than speculative.

until 009F == D7 3600
wait 60
dump main-menu-ready
press a 2

until 009F == 3C 1200
wait 60
dump rider-select-ready
press a 2

until 009F == 6D 1200
wait 60
dump tours-ready
press a 2

until 009F == F6 1200
wait 60
dump tracks-ready
press a 2

until 009F != F6 1200
wait 60
dump after-track-confirm
until 009F == 16 1200
wait 60
dump now-playing-ready
press a 2

until 0313 == 01 1800
wait 60
dump race-entered

press right 30
press right 30
press right 30
press right 30
press right 60
dump finish-probe-start

press right+b 24
press right 24
press right+b 24
press right 24
press right+b 24
press right 24
press right+b 24
press right 24
press right+b 24
press right 24
dump finish-probe-05
press right+b 24
press right 24
press right+b 24
press right 24
press right+b 24
press right 24
press right+b 24
press right 24
press right+b 24
press right 24
dump finish-probe-10
press right+b 24
press right 24
press right+b 24
press right 24
press right+b 24
press right 24
press right+b 24
press right 24
press right+b 24
press right 24
dump finish-probe-15
press right+b 24
press right 24
press right+b 24
press right 24
press right+b 24
press right 24
press right+b 24
press right 24
press right+b 24
press right 24
dump finish-probe-20
press right+b 24
press right 24
press right+b 24
press right 24
press right+b 24
press right 24
press right+b 24
press right 24
press right+b 24
press right 24
dump finish-probe-25
press right+b 24
press right 24
press right+b 24
press right 24
press right+b 24
press right 24
press right+b 24
press right 24
press right+b 24
press right 24
dump finish-probe-30

dump finish-probe-terminal
# Dense only where the coarse pass localized information-bearing boundaries:
# +60..+80 contains finish-surface entry; +160..+180 contains the 0x14
# checkpoint/finish activation. Keep the middle sparse.
wait 50
dump object-tail-050
wait 1
dump object-tail-051
wait 1
dump object-tail-052
wait 1
