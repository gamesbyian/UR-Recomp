+int snesrecomp_desktop_set_linear_filtering(int enabled) {
+  g_config.linear_filtering = enabled != 0;
+  if (g_renderer_funcs.Reconfigure)
+    g_renderer_funcs.Reconfigure();
+  return 1;
+}
+
+int snesrecomp_desktop_get_linear_filtering(void) {
+  return g_config.linear_filtering ? 1 : 0;
+}
